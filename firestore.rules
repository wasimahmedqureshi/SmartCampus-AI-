rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() {
      return isSignedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        ? get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() { return role() in ['admin','teacher']; }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isSignedIn() && request.auth.uid == studentId;
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == studentId
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('uid' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }
    match /progress/{recordId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /quizResults/{recordId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    // AI key + branding — readable by all signed-in users, writable only by admin
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
